# Which provider to use: openrouter (default), gemini, ollama, or fake
ARCH_PROVIDER=openrouter

# OpenRouter: free account, no card needed. Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Gemini (optional): free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=...

# Override the provider's default model (optional)
# ARCH_MODEL=qwen/qwen3-coder:free